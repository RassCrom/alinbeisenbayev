# Read by Cloudflare Pages, the live host. vercel.json carries the same rules for a Vercel deploy.
# Hashed build output never changes under the same name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
# Gallery files carry a content stamp in their name (scripts/gallery.py).
/gallery/*
  Cache-Control: public, max-age=31536000, immutable

# Media keeps its filename when re-exported, so a week, not forever.
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/videos/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/og/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
