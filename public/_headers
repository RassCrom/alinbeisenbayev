# Netlify counterpart of the "headers" block in vercel.json; keep the two in sync.
# Hashed build output never changes under the same name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Media keeps its filename when re-exported, so a week, not forever.
/atlas/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/videos/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/og/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/telegram_media/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
