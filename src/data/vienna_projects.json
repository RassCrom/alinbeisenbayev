      "id": "astana-buildings",
      "slug": "astana-buildings",
      "title": "Building Ages of Astana",
      "tagline": "Interactive web map about Astana buildings - construction year, height, etc.",
      "status": "complete",
      "featured": true,
      "type": "website",
      "category": "interactive-map",
      "keywords": [
        "Astana",
        "buildings",
        "3D",
