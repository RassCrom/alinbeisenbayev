    {
      "id": "silk-road",
      "slug": "silk-road",
      "title": "Silk Road Through Centuries",
      "tagline": "Print map showcasing the historical Silk Road trade network with a focus on Central Asian routes",
      "status": "complete",
      "featured": true,
      "type": "static-map",
      "category": "print",
      "keywords": [
        "print",
        "history",
        "cartography",
        "silk road",
        "Central Asia"
      ],
      "role": "solo",
      "startDate": "2025-04",
      "endDate": "2025-06",
      "awards": [
        "British Cartographic Society - Winner"
      ],
      "coverImage": "/images/projects/silk-road/preview.webp",
      "context": "Developed under the TU Wien course - Project Map Creation. The task was to produce any map for print. Historical cartography felt like the natural territory.",
      "idea": "Since childhood I have been fascinated by history - a passion inherited from my grandfather. Among several shortlisted ideas, the Silk Road stood out: it is the oldest form of globalization and runs through the heart of the Central Asian cultures I grew up around.",
      "design": "The goal was a moody, atmospheric design - achieved by blending a dark base with relief shading and careful typographic hierarchy. Color palettes kept warm and earthy to evoke trade routes and ancient parchment.",
      "inspiration": "Primary reference was the Silk Road map by Simeon Netchev - admired for its compositional clarity and historical depth.",
      "process": [
        {
          "step": 1,
          "title": "Historical Research",
          "description": "Studied the Silk Road trade network through books, academic articles, and historical GIS datasets. Used NotebookLM to organize research across sources. Identified key cities, route variants, and centuries to represent."
        },
        {
          "step": 2,
          "title": "Map Composition",
          "description": "Built the base map and spatial layers in QGIS. Exported to Figma for typography, symbology refinement, and final print layout.",
          "image": "/images/projects/silk-road/close-details.webp"
        }
      ],
      "outcome": "Won the British Cartographic Society open map competition, September 2025.",
      "stack": [
        "NotebookLM",
        "QGIS",
        "Figma"
      ],
      "liveUrl": "https://rasscrom.github.io/tulparmaps-collection/#map=silk%20road.png",
