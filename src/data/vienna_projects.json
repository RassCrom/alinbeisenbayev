    {
      "id": "earth-on-fire",
      "slug": "earth-on-fire",
      "title": "Earth on Fire",
      "tagline": "Global print map of fire ignition points accumulated over a 5-year period",
      "status": "complete",
      "featured": true,
      "type": "static-map",
      "category": "print",
      "keywords": [
        "fire",
        "global",
        "print",
