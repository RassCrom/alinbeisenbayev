# ---- Browser (build time) ----
# Community submissions on /journal/map-awards (see supabase/award_submissions.sql).
# Copy to .env.local for local dev; set the same two as build variables on
# Cloudflare Pages. Without them, the "Add an award" form saves entries only
# in the visitor's browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Server: the "Work with me" form (functions/api/contact.ts) ----
# Never prefixed with VITE_, so they stay out of the browser bundle.
# Production: Cloudflare > Pages > the project > Settings > Variables and
# Secrets (add RESEND_API_KEY as a secret). Local dev: put them in .env.local.
#
# Email needs the first two. Without them, and without the Supabase pair
# below, the form tells the visitor it did not send and shows the direct
# address.
RESEND_API_KEY=
CONTACT_TO=
# Optional. Resend's test sender is used until a domain is verified there.
CONTACT_FROM=
# Optional. Also stores each inquiry (see supabase/inquiries.sql).
SUPABASE_URL=
SUPABASE_ANON_KEY=
