{
  "cleanUrls": true,
  "redirects": [
    { "source": "/skills", "destination": "/about", "permanent": true },
    { "source": "/gallery", "destination": "/works", "permanent": true },
    { "source": "/connect", "destination": "/contact", "permanent": true },
    { "source": "/stories", "destination": "/journal", "permanent": true },
    { "source": "/stories/:slug", "destination": "/journal/:slug", "permanent": true },
    { "source": "/blog", "destination": "/journal", "permanent": true },
    { "source": "/blog/:slug", "destination": "/journal/:slug", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/gallery/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(images|videos|og|files)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/([^/]+\\.(?:webp|jpg|jpeg|png|svg|ico))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    }
  ],
  "rewrites": [{ "source": "/((?!assets/).*)", "destination": "/index.html" }]
}
